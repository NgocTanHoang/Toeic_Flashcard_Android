<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lexora Deep Navy Slate Gradient (#090E18 -> #132036) -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF090E18" />
                <item android:offset="0.55" android:color="#FF0E1727" />
                <item android:offset="1.0" android:color="#FF132036" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Soft Ambient Radial Sheen -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="56">
                <item android:offset="0.0" android:color="#261E3A5F" />
                <item android:offset="0.7" android:color="#0C132036" />
                <item android:offset="1.0" android:color="#00090E18" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
