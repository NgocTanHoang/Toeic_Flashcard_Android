<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Matte Slate Base (#0B101B -> #0F1726 -> #121C2E) -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF0B101B" />
                <item android:offset="0.52" android:color="#FF0F1726" />
                <item android:offset="1.0" android:color="#FF121C2E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Soft Matte Radial Depth -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="56">
                <item android:offset="0.0" android:color="#221E2F4D" />
                <item android:offset="0.7" android:color="#0C121C2E" />
                <item android:offset="1.0" android:color="#000B101B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
