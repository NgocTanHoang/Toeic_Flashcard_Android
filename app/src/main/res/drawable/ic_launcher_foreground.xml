<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Layer 1: Grounded Soft Drop Shadow (~70% Safe Zone scale) -->
    <path android:pathData="M20,59 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="59"
                android:gradientRadius="34">
                <item android:offset="0.0" android:color="#8002050B" />
                <item android:offset="0.65" android:color="#3002050B" />
                <item android:offset="1.0" android:color="#0002050B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layer 2: Back Glass Card (+9 deg) -->
    <group
        android:pivotX="58"
        android:pivotY="54"
        android:rotation="9">
        <path
            android:pathData="M46,26 L68,26 A10,10 0 0,1 78,36 L78,70 A10,10 0 0,1 68,80 L46,80 A10,10 0 0,1 36,70 L36,36 A10,10 0 0,1 46,26 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="36"
                    android:startY="26"
                    android:endX="78"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#FF1C2D4A" />
                    <item android:offset="1.0" android:color="#FF132438" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="36"
                    android:startY="26"
                    android:endX="78"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#6638BDF8" />
                    <item android:offset="1.0" android:color="#6634D399" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Layer 3: Front Frosted Glass Card (-4 deg) + Lexora Geometric "L" Monogram -->
    <group
        android:pivotX="51"
        android:pivotY="54"
        android:rotation="-4">

        <!-- Soft cast shadow onto back card -->
        <path
            android:fillColor="#52030712"
            android:pathData="M40,28 L64,28 A10,10 0 0,1 74,38 L74,72 A10,10 0 0,1 64,82 L40,82 A10,10 0 0,1 30,72 L30,38 A10,10 0 0,1 40,28 Z" />

        <!-- Front Frosted Glass Card Body & Fine Top-Right Rim -->
        <path
            android:pathData="M38,26 L62,26 A10,10 0 0,1 72,36 L72,70 A10,10 0 0,1 62,80 L38,80 A10,10 0 0,1 28,70 L28,36 A10,10 0 0,1 38,26 Z"
            android:strokeWidth="1.2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="26"
                    android:endX="72"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#F51A2A46" />
                    <item android:offset="0.55" android:color="#F8121E34" />
                    <item android:offset="1.0" android:color="#FA0D1728" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="26"
                    android:endX="72"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#55FFFFFF" />
                    <item android:offset="1.0" android:color="#3338BDF8" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Diagonal Frosted Glass Specular Sheen -->
        <path android:pathData="M38,26.8 L62,26.8 A9.2,9.2 0 0,1 71.2,36 L71.2,44 C59,41 42,50 28.8,60 L28.8,36 A9.2,9.2 0 0,1 38,26.8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="28.8"
                    android:startY="26.8"
                    android:endX="58"
                    android:endY="58">
                    <item android:offset="0.0" android:color="#28FFFFFF" />
                    <item android:offset="1.0" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Lexora Geometric "L" Monogram Ribbon (#38BDF8 -> #34D399) -->
        <path
            android:pathData="M28,35 L28,70 A10,10 0 0,0 38,80 L63,80"
            android:strokeWidth="6.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="35"
                    android:endX="63"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#FF38BDF8" />
                    <item android:offset="0.5" android:color="#FF22D3EE" />
                    <item android:offset="1.0" android:color="#FF34D399" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Crisp Inner Highlight on the "L" Edge -->
        <path
            android:pathData="M28,35 L28,70 A10,10 0 0,0 38,80 L63,80"
            android:strokeWidth="1.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="35"
                    android:endX="63"
                    android:endY="80">
                    <item android:offset="0.0" android:color="#77FFFFFF" />
                    <item android:offset="1.0" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
