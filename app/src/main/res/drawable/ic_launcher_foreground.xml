            android:pathData="M39.5,69.5 L55.5,69.5 A1.5,1.5 0 0,1 57,71 A1.5,1.5 0 0,1 55.5,72.5 L39.5,72.5 A1.5,1.5 0 0,1 38,71 A1.5,1.5 0 0,1 39.5,69.5 Z" />
